# Backend API URL (used in production build)
VITE_API_URL=https://your-backend-domain.onrender.com

# EmailJS welcome email, sent when a member with an email address is added (emailjs.com).
# Set these in Netlify: Site configuration > Environment variables, then redeploy.
# Template variables available: {{to_name}} {{first_name}} {{to_email}} {{member_id}} {{church_name}} {{check_in_url}} (and {{name}} {{time}} {{message}} for the default template)
# The template's "To Email" field must be {{to_email}}. A ready-made template is in emailjs/welcome-template.html.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_WELCOME_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key
